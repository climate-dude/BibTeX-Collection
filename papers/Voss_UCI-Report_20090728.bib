@TechReport{Voss:UCI-Report:20090728,
 author		= {Katalyn Voss},
 institution	= {University of California - Irvine},
 title		= {Developing a Global Groundwater Scarcity Index},
 pages		= 23,
 day		= 28,
 month		= jul,
 year		= 2009,
 abstract	= {Water scarcity is a major problem facing the global community, but most research of the scarcity of water resources has not included groundwater aquifers. This study explicitly evaluates groundwater use compared to groundwater availability and attempts to create an accurate global groundwater scarcity index to determine which regions of the world face groundwater stress. This index is created by dividing groundwater withdrawal by groundwater recharge and applying a standard scarcity scale established by the United Nations. The resulting maps correctly reflect known regions of water stress. The second component of the study attempts to validate observed changes in total water storage through satellite data generated by the GRACE project. Model-generated data from GLDAS and WaterGap, which reflect natural-caused changes in total water storage, were subtracted from observational GRACE data, which includes both natural and anthropogenic effects on total storage, in order to determine the human impact on total water storage. Some common trends were found, and a region in northwest Australia experiencing a strong negative trend in total water storage was selected as a case study. Mining activity was suspected to be the main cause of the negative trend in this area, but was found to only contribute a small percentage of the overall trend. A comparison between GRACE and the groundwater scarcity index shows that the two are poorly correlated. This indicates that further research and more complete data on groundwater use, preferably regional groundwater withdrawal rates within countries, is needed in order to create an accurate representation of global groundwater stress.}
}

