 author		= {Thomas Pierce and Christopher Geron and Lucille Bender and Robin Dennis and Gail Tonnesen and Alex Guenther},
 title		= {Influence of Increased Isoprene Emissions on Regional Ozone Modeling},
 journal	= JGR,
