@Article{Billings_NatGeosci_2020,
 author		= {Sharon A. Billings and L{\'{i}}gia F. T. {de Souza}},
 title		= {Earth's soil harbours ancient carbon},
 journal	= NatGeosci,
 doi		= {10.1038/s41561-020-0614-1},
 year		= 2020,
 abstract	= {Organic carbon in the top metre of Earth's soils is far older than previously thought, averaging 4,800 years old. These radiocarbon-derived age estimates require us to recalibrate our expectations of ecosystem gains and losses of carbon.}
}
