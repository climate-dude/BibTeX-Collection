@Article{Trumbore_Science_19960419,
 author		= {Susan E. Trumbore and Oliver A. Chadwick and Ronald Amundson},
 title		= {Rapid Exchange Between Soil Carbon and Atmospheric Carbon Dioxide Driven by Temperature Change},
 journal	= {Science},
 volume		= 272,
 number		= 5260,
 pages		= {393--396},
 doi		= {10.1126/science.272.5260.393},
 day		= 19,
 month		= apr,
 year		= 1996,
 abstract	= {Comparison of $^{14}$C (carbon-14) in archived (pre-1963) and contemporary soils taken along an elevation gradient in the Sierra Nevada, California, demonstrates rapid (7 to 65 years) turnover for 50 to 90 percent of carbon in the upper 20 centimeters of soil (A horizon soil carbon). Carbon turnover times increased with elevation (decreasing temperature) along the Sierra transect. This trend was consistent with results from other locations, which indicates that temperature is a dominant control of soil carbon dynamics. When extrapolated to large regions, the observed relation between carbon turnover and temperature suggests that soils should act as significant sources or sinks of atmospheric carbon dioxide in response to global temperature changes.}
}

