@Article{Houghton_GCB_20130901,
 author		= {Richard A. Houghton},
 title		= {Keeping management effects separate from environmental effects in terrestrial carbon accounting},
 journal	= GCB,
 volume		= 19,
 number		= 9,
 pages		= {2609--2612},
 doi		= {10.1111/gcb.12233},
 day		= 1,
 month		= sep,
 year		= 2013,
 abstract	= {This study proposes that carbon fluxes identified as being from land use and land-cover change (LULCC) include only that component of a flux that can be attributed to LULCC, exclusive of the effects of environmental change (CO$_2$, climate, N, etc.). This proposal seems too obvious to need saying, but published estimates of the LULCC flux are widely variable for reasons that have more to do with modeling environmental effects than with LULCC.}
}
