 author		= {A. Guenther and T. Karl and P. Harley and C. Wiedinmyer and P. I. Palmer and C. Geron},
 title		= {Estimates of Global Terrestrial Isoprene Emissions Using {MEGAN} ({M}odel of {E}missions of {G}ases and {A}erosols from {N}ature)},
 journal	= ACP,
 volume		= 6,
 number		= 11,
 pages		= {3181--3210},
 url		= {http://www.atmos-chem-phys.net/6/3181/2006/},
