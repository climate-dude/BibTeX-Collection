 author		= {Qing Sun and Fortunat Joos and Sebastian Lienert and Sarah Berthet and Dustin Carroll and Cheng Gong and Akihiko Ito and Atul K. Jain and Sian Kou-Giesbrecht and Angela Landolfi and Manfredi Manizza and Naiqing Pan and Michael Prather and Pierre Regnier and Laure Resplandy and Roland S\'{e}f\'{e}rian and Hao Shi and Parvadha Suntharalingam and Rona L. Thompson and Hanqin Tian and Nicolas Vuichard and S\"{o}nke Zaehle and Qing Zhu},
 title		= {The Modeled Seasonal Cycles of Surface {N$_2$O} Fluxes and Atmospheric {N$_2$O}},
