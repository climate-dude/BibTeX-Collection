 author		= {Dorothea Frank and Markus Reichstein and Michael Bahn and Kirsten Thonicke and David Frank and Miguel D. Mahecha and Pete Smith and Marijn {van der Velde} and Sara Vicca and Flurin Babst and Christian Beer and Nina Buchmann and Josep G. Canadell and Philippe Ciais and Wolfgang Cramer and Andreas Ibrom and Franco Miglietta and Ben Poulter and Anja Rammig and Sonia I. Seneviratne and Ariane Walz and Martin Wattenbach and Miguel A. Zavala and Jakob Zscheischler},
 title		= {Effects of Climate Extremes on the Terrestrial Carbon Cycle: Concepts, Processes and Potential Future Impacts},
 journal	= GCB,
 volume		= 21,
