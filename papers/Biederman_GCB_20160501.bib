 author		= {Joel A. Biederman and Russell L. Scott and Michael L. Goulden and Rodrigo Vargas and Marcy E. Litvak and Thomas E. Kolb and Enrico A. Yepez and Walter C. Oechel and Peter D. Blanken and Tom W. Bell and Jaime Garatuza-Payan and Gregory E. Maurer and Sabina Dore and Sean P. Burns},
 title		= {Terrestrial Carbon Balance in a Drier World: The Effects of Water Availability in Southwestern {N}orth {A}merica},
 journal	= GCB,
 volume		= 22,
