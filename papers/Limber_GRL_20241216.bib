@Article{Limber_GRL_20241216,
 author		= {Russ Limber and Elias C. Massoud and Bin Guan and Forrest M. Hoffman and Jitendra Kumar},
 title		= {Influence of Atmospheric Rivers on {A}laskan River Ice},
 journal	= GRL,
 volume		= 51,
 number		= 23,
 pages		= {e2024GL111544},
 doi		= {10.1029/2024GL111544},
 day		= 16,
 month		= dec,
 year		= 2024,
 abstract	= {Atmospheric rivers (ARs) transport vast amounts of moisture from low to high latitude regions. One region particularly impacted by ARs is Interior Alaska (AK). We analyze the impact of ARs on the annual river ice breakup date for 26 locations in AK. We investigate the AR-driven rise in local air temperatures and explore the relationship between ARs and precipitation, including extremes and interannual variability. We found that AR events lead to an increase in local air temperatures for over 1 week (by $\approx$1$^\circ$C). ARs account for 40\% of total precipitation, explain 47\% of precipitation variability, and make up 59\% of extreme precipitation events, each year. By estimating the heat transfer between winter precipitation and the river ice surface, we conclude that increased precipitation during the coldest period of the year delays river ice breakup dates, while precipitation occurring close to the breakup date has little impact on breakup timing.}
}

