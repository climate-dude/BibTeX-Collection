 author		= {Nathalie de Noblet-Ducoudr{\'e} and Juan-Pablo Boisier and Andy Pitman and Gordon B. Bonan and Victor Brovkin and Faye Cruz and C. Delire and V. Gayler and B. J. J. M. {van den Hurk} and P. J. Lawrence and M. K. {van der Molen} and C. M{\"u}ller and C. H. Reick and B. J. Strengers and A. Voldoire},
 title		= {Determining Robust Impacts of Land-Use-Induced Land Cover Changes on Surface Climate over {N}orth {A}merica and {E}urasia: Results from the First Set of {LUCID} Experiments},
 journal	= JClim,
 volume		= 25,
