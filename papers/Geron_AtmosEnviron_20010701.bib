@Article{Geron:AtmosEnviron:20010701,
 author		= {Chris Geron and Peter Harley and Alex Guenther},
 title		= {Isoprene Emission Capacity for {US} Tree Species},
 journal	= AtmosEnviron,
 volume		= 35,
 number		= 19,
 pages		= {3341--3352},
 note		= {doi:\href{http://dx.doi.org/10.1016/S1352-2310(00)00407-6}{10.1016/S1352-2310(00)00407-6}},
 real_doi	= {10.1016/S1352-2310(00)00407-6},
 day		= 1,
 month		= jul,
 year		= 2001,
 abstract	= {Isoprene emission capacity measurements are presented from 18 North American oak (\textit{Quercus}) species and species from six other genera previously found to emit significant quantities of isoprene. Sampling was conducted at physiographically diverse locations in North Carolina, Central California, and Northern Oregon. Emissions from several sun leaves of each species were measured at or near standard conditions (leaf temperature of 30$^\circ$C and photosynthetically active radiation of 1000~$\mu$mol~m$^{-2}$~s$^{-1}$) using environmentally controlled cuvette systems and gas chromatography with reduction gas detectors. Species mean emission capacity ranged from 39 to 158~$\mu$g~C~g$^{-1}$~h$^{-1}$ (mean of 86), or 22 to 79~nmol~m$^{-2}$~s$^{-1}$ (mean of 44). These rates are 2--28 times higher than those previously reported from the same species, which were summarized in a recent study where isoprene emission rates were assigned based on published data and taxonomy. These discrepancies were attributed to differences in leaf environment during development, measurement technique (branch or plant enclosure versus leaf enclosure), and lack of environmental measurements associated with some of the earlier branch enclosure measurements. Mass-based emission capacities for 15 of 18 oak species, sweetgum (\textit{Liquidambar styraciflua}), and poplars (\textit{Populus trichocarpa} and \textit{P. deltoides}) were within ranges used in current biogenic volatile organic compound (BVOC) emission models, while measured rates for the remaining three oak species, \textit{Nyssa sylvatica}, \textit{Platanus occidentalis}, \textit{Robinia pseudoacacia}, \textit{Salix nigra}, and \textit{Populus} hybrids (\textit{Populus trichocarpa} $\times$ \textit{P. deltoides}) were considerably higher. In addition, mean specific leaf mass of the oak species was 30\% higher than assumed in current emission models. Emission rates reported here and in other recent studies support recent conclusions that isoprene emission capacities for sun leaves of high emitting species may be better represented by a value of $100 \pm 50$~$\mu$g~C~g$^{-1}$~h$^{-1}$ during hot summer conditions. We also find that intermediate isoprene emission rates previously suggested for some tree species may not represent their true emission capacities, and that broadleaf plant species may have either low ($<1.0$~$\mu$g~C~g$^{-1}$~h$^{-1}$) or very high ($\sim 100$~$\mu$g~C~g$^{-1}$~h$^{-1}$) genetic capacity to emit isoprene when mature foliage is exposed to a high ambient temperature and light environment.}
}

