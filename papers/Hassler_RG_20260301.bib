 author		= {Birgit Hassler and Forrest M. Hoffman and Rebecca Beadling and Ed Blockley and Bo Huang and Jiwoo Lee and Valerio Lembo and Jared Lewis and Jianhua Lu and Luke Madaus and Elizaveta Malinina and Brian Medeiros and Wilfried Pokam and Enrico Scoccimarro and Ranjini Swaminathan},
 title		= {Systematic Benchmarking of Climate Models: {M}ethodologies, Applications, and New Directions},
 journal	= RG,
