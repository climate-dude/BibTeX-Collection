@Article{Walker_JGRB_20140527,
 author		= {Anthony P. Walker and Paul J. Hanson and Martin G. {De Kauwe} and Belinda E. Medlyn and Sönke Zaehle and Shinichi Asao and Michael Dietze and Thomas Hickler and Chris Huntingford and Colleen M. Iversen and Atul Jain and Mark Lomas and Yiqi Luo and Heather McCarthy and William J. Parton and I. Colin Prentice and Peter E. Thornton and Shusen Wang and Ying-Ping Wang and David Warlind and Ensheng Weng and Jeffrey M. Warren and F. Ian Woodward and Ram Oren and Richard J. Norby},
 title		= {Comprehensive Ecosystem Model--Data Synthesis using Multiple Data Sets at Two Temperate Forest Free-Air {CO$_2$} Enrichment Experiments: Model Performance at Ambient {CO$_2$} Concentration},
 journal	= JGRB,
 volume		= 119,
