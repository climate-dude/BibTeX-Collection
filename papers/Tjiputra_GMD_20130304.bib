 author		= {J. F. Tjiputra and C. Roelandt and M. Bentsen and D. M. Lawrence and T. Lorentzen and J. Schwinger and {\O}. Seland and C. Heinze},
 title		= {Evaluation of the Carbon Cycle Components in the {N}orwegian {E}arth {S}ystem {M}odel ({NorESM})},
