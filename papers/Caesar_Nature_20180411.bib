 author		= {L. Caesar and S. Rahmstorf and A. Robinson and G. Feulner and V. Saba},
 title		= {Observed Fingerprint of a Weakening {A}tlantic {O}cean Overturning Circulation},
 journal	= Nature,
 volume		= 556,
 number		= 7700,
 pages		= {191--196},
