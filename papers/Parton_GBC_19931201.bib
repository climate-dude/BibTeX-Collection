@Article{Parton_GBC_19931201,
 author		= {W. J. Parton and J. M. O. Scurlock and D. S. Ojima and T. G. Gilmanov and R. J. Scholes and D. S. Schimel and T. Kirchner and J-C. Menaut and T. Seastedt and E. {Garcia Moya} and Apinan Kamnalrut and J. I. Kinyamario},
 title		= {Observations and modeling of biomass and soil organic matter dynamics for the grassland biome worldwide},
 journal	= GBC,
 volume		= 7,
 number		= 4,
 pages		= {785--809},
 doi		= {10.1029/93GB02042},
 day		= 1,
 month		= dec,
 year		= 1993,
 abstract	= {Century is a model of terrestrial biogeochemistry based on relationships between climate, human management (fire, grazing), soil properties, plant productivity, and decomposition. The grassland version of the Century model was tested using observed data from 11 temperate and tropical grasslands around the world. The results show that soil C and N levels can be simulated to within $\pm$25\% of the observed values (100 and 75\% of the time, respectively) for a diverse set of soils. Peak live biomass and plant production can be simulated within $\pm$25\% of the observed values (57 and 60\% of the time, respectively) for burned, fertilized, and irrigated grassland sites where precipitation ranged from 22 to over 150~cm. Live biomass can be generally predicted to within $\pm$50\% of the observed values (57\% of the time). The model underestimated the live biomass in extremely high plant production years at two of the Russian sites. A comparison of Century model results with statistical models showed that the Century model had slightly higher $r^2$ values than the statistical models. Data and calibrated model results from this study are useful for analysis and description of grassland carbon dynamics, and as a reference point for testing more physiologically based models prediction's of net primary production and biomass. Results indicate that prediction of plant and soil organic matter (C and N) dynamics requires knowledge of climate, soil texture, and N inputs.}
}
