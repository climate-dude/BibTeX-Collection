 author		= {Stephanie M. Downes and Anand Gnanadesikan and Stephen M. Griffies and Jorge L. Sarmiento},
 title		= {Water Mass Exchange in the {S}outhern {O}cean in Coupled Climate Models},
 journal	= JPO,
 volume		= 41,
