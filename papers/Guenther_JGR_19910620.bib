 author		= {Alex B. Guenther and Russell K. Monson and Ray Fall},
 title		= {Isoprene and Monoterpene Emission Rate Variability: Observations With Eucalyptus and Emission Rate Algorithm Development},
 journal	= JGR,
 volume		= 96,
 number		= {D6},
 pages		= {10799--10808},
 note		= {doi:\href{http://dx.doi.org/10.1029/91JD00960}{10.1029/91JD00960}},
 real_doi	= {10.1029/91JD00960},
 day		= 20,
