 author		= {David Fowler and Mhairi Coyle and Ute Skiba and Mark A. Sutton and J. Neil Cape and Stefan Reis and Lucy J. Sheppard and Alan Jenkins and Bruna Grizzetti and James N. Galloway and Peter Vitousek and Allison Leach and Alexander F. Bouwman and Klaus Butterbach-Bahl and Frank Dentener and David Stevenson and Marcus Amann and Maren Voss},
 title		= {The Global Nitrogen Cycle in the Twenty-first Century},
 journal	= PhilTransRSocB,
