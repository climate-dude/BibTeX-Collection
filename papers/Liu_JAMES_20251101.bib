 author		= {Amy X. Liu and Claire M. Zarakas and Benjamin G. Buchovecky and Linnia R. Hawkins and Alana S. Cordak and Ashley E. Cornish and Marja Haagsma and Gabriel J. Kooperman and Chris J. Still and Charles D. Koven and Alexander J. Turner and David S. Battisti and James T. Randerson and Forrest M. Hoffman and Abigail L. S. Swann},
 title		= {Atmospheric Feedbacks Reverse the Sensitivity of Modeled Photosynthesis to Stomatal Function},
 journal	= JAMES,
 volume		= 17,
 number		= 11,
 pages		= {e2025MS005177},
 doi		= {10.1029/2025MS005177},
 day		= 1,
