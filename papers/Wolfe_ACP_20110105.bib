 author		= {G. M. Wolfe and J. A. Thornton},
 title		= {The {C}hemistry of {A}tmosphere-{F}orest {E}xchange ({CAFE}) {M}odel -- {P}art 1: Model description and characterization},
 journal	= ACP,
 volume		= 11,
 number		= 1,
