@Article{Koven_PNAS_20110906,
 author		= {Charles D. Koven and Bruno Ringeval and Pierre Friedlingstein and Philippe Ciais and Patricia Cadule and Dmitry Khvorostyanov and Gerhard Krinner and Charles Tarnocai},
 title		= {Permafrost Carbon-climate Feedbacks Accelerate Global Warming},
 journal	= PNAS,
 volume		= 108,
 number		= 36,
 pages		= {14769--14774},
 doi		= {10.1073/pnas.1103910108},
 day		= 6,
 month		= sep,
 year		= 2011,
 abstract	= {Permafrost soils contain enormous amounts of organic carbon, which could act as a positive feedback to global climate change due to enhanced respiration rates with warming. We have used a terrestrial ecosystem model that includes permafrost carbon dynamics, inhibition of respiration in frozen soil layers, vertical mixing of soil carbon from surface to permafrost layers, and CH$_4$ emissions from flooded areas, and which better matches new circumpolar inventories of soil carbon stocks, to explore the potential for carbon-climate feedbacks at high latitudes. Contrary to model results for the Intergovernmental Panel on Climate Change Fourth Assessment Report (IPCC AR4), when permafrost processes are included, terrestrial ecosystems north of 60$^\circ$N could shift from being a sink to a source of CO$_2$ by the end of the 21st century when forced by a Special Report on Emissions Scenarios (SRES) A2 climate change scenario. Between 1860 and 2100, the model response to combined CO$_2$ fertilization and climate change changes from a sink of 68~Pg to a 27$\pm$7~Pg sink to 4$\pm$18~Pg source, depending on the processes and parameter values used. The integrated change in carbon due to climate change shifts from near zero, which is within the range of previous model estimates, to a climate-induced loss of carbon by ecosystems in the range of 25$\pm$3 to 85$\pm$16~Pg~C, depending on processes included in the model, with a best estimate of a 62$\pm$7~Pg~C loss. Methane emissions from high-latitude regions are calculated to increase from 34~Tg~CH$_4$/y to 41--70~Tg~CH$_4$/y, with increases due to CO$_2$ fertilization, permafrost thaw, and warming-induced increased CH$_4$ flux densities partially offset by a reduction in wetland extent.}
}
