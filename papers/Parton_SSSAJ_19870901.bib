 author		= {W. J. Parton and D. S. Schimel and C. V. Cole and D. S. Ojima},
 title		= {Analysis of Factors Controlling Soil Organic Matter Levels in {G}reat {P}lains Grasslands},
 journal	= SSSAJ,
 volume		= 51,
 number		= 5,
 pages		= {1173--1179},
