 author		= {Maosheng Zhao and Steven W. Running and Ramakrishna R. Nemani},
 title		= {Sensitivity of {M}oderate {R}esolution {I}maging {S}pectroradiometer ({MODIS}) Terrestrial Primary Production to the Accuracy of Meteorological Reanalyses},
 journal	= JGR,
 volume		= 111,
