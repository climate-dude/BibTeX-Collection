@Article{Schlesinger_PNAS_20090106,
 author		= {William H. Schlesinger},
 title		= {On the Fate of Anthropogenic Nitrogen},
 journal	= PNAS,
 volume		= 106,
 number		= 1,
 pages		= {203--208},
 doi		= {10.1073/pnas.0810193105},
 day		= 6,
 month		= jan,
 year		= 2009,
 abstract	= {This article provides a synthesis of literature values to trace the fate of 150 Tg/yr anthropogenic nitrogen applied by humans to the Earth's land surface. Approximately 9 TgN/yr may be accumulating in the terrestrial biosphere in pools with residence times of ten to several hundred years. Enhanced fluvial transport of nitrogen in rivers and percolation to groundwater accounts for $\approx$35 and 15 TgN/yr, respectively. Greater denitrification in terrestrial soils and wetlands may account for the loss of $\approx$17 TgN/yr from the land surface, calculated by a compilation of data on the fraction of N$_2$O emitted to the atmosphere and the current global rise of this gas in the atmosphere. A recent estimate of atmospheric transport of reactive nitrogen from land to sea (NO$_\mathrm{x}$ and NH$_\mathrm{x}$) accounts for 48 TgN/yr. The total of these enhanced sinks, 124 TgN/yr, is less than the human-enhanced inputs to the land surface, indicating areas of needed additional attention to global nitrogen biogeochemistry. Policy makers should focus on increasing nitrogen-use efficiency in fertilization, reducing transport of reactive N to rivers and groundwater, and maximizing denitrification to its N$_2$ endproduct.}
}

