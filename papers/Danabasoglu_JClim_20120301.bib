 author		= {Gokhan Danabasoglu and Susan C. Bates and Bruce P. Briegleb and Steven R. Jayne and Markus Jochum and William G. Large and Synte Peacock and Steve G. Yeager},
 title		= {The {CCSM4} Ocean Component},
 journal	= JClim,
 volume		= 25,
