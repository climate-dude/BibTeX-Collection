 author		= {Kitack Lee and Christopher L. Sabine and Toste Tanhua and Tae-Wook Kim and Richard A. Feely and Hyun-Cheol Kim},
 title		= {Roles of Marginal Seas in Absorbing and Storing Fossil Fuel {CO}$_2$},
 journal	= EES,
 volume		= 4,
