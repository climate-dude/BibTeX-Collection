 title		= {Nonlinearity of Ocean Carbon Cycle Feedbacks in {CMIP5} {E}arth System Models},
 journal	= JClim,
 volume		= 27,
 number		= 11,
 pages		= {3869--3888},
 doi		= {10.1175/JCLI-D-13-00452.1},
 day		= 1,
