 author		= {Qing Zhu and Daniel J. Jacob and Kunxiaojia Yuan and Fa Li and Benjamin R. K. Runkle and Min Chen and A. Anthony Bloom and Benjamin Poulter and James D. East and William J. Riley and Gavin McNicol and John Worden and Christian Frankenberg and Meghan Halabisky},
 title		= {Advancements and Opportunities to Improve Bottom-up Estimates of Global Wetland Methane Emissions},
 journal	= ERL,
