 author		= {Christopher S. Potter and Susan E. Alexander and Joseph C. Coughlan and Steven A. Klooster},
 title		= {Modeling Biogenic Emissions of Isoprene: Exploration of Model Drivers, Climate Control Algorithms, and Use of Global Satellite Observations},
