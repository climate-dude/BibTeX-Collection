@Article{Myneni:PNAS:20070313,
 author		= {Ranga B. Myneni and Wenze Yang and Ramakrishna R. Nemani and Alfredo R. Huete and Robert E. Dickinson and Yuri Knyazikhin and Kamel Didan and Rong Fu and Robinson I. Negr\'{o}n Ju\'{a}rez and Sasan S. Saatchi and Hirofumi Hashimoto and Kazuhito Ichii and Jeffrey T. Morisette and Eric F. Vermote and David P. Roy and Robert E. Wolfe and Mark A. Friedl and Steven W. Running and Petr Votava and Nazmi El-Saleous and Sadashiva Devadiga and Yin Su and Vincent V. Salomonson},
 title		= {Large Seasonal Swings in Leaf Area of {A}mazon Rainforests},
 journal	= PNAS,
 volume		= 104,
 number		= 12,
 pages		= {4820--4823},
 note		= {doi:\href{http://dx.doi.org/10.1073/pnas.0611338104}{10.1073/pnas.0611338104}},
 real_doi	= {10.1073/pnas.0611338104},
 day		= 13,
 month		= mar,
 year		= 2007,
 abstract	= {Despite early speculation to the contrary, all tropical forests studied to date display seasonal variations in the presence of new leaves, flowers, and fruits. Past studies were focused on the timing of phenological events and their cues but not on the accompanying changes in leaf area that regulate vegetation–atmosphere exchanges of energy, momentum, and mass. Here we report, from analysis of 5 years of recent satellite data, seasonal swings in green leaf area of $\sim$25\% in a majority of the Amazon rainforests. This seasonal cycle is timed to the seasonality of solar radiation in a manner that is suggestive of anticipatory and opportunistic patterns of net leaf flushing during the early to mid part of the light-rich dry season and net leaf abscission during the cloudy wet season. These seasonal swings in leaf area may be critical to initiation of the transition from dry to wet season, seasonal carbon balance between photosynthetic gains and respiratory losses, and litterfall nutrient cycling in moist tropical forests.}
}

