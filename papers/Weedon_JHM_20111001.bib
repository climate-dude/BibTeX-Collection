 title		= {Creation of the {WATCH} Forcing Data and Its Use to Assess Global and Regional Reference Crop Evaporation over Land during the Twentieth Century},
 journal	= JHM,
 volume		= 12,
 number		= 5,
 pages		= {823--848},
