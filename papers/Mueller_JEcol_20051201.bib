 author		= {Rebecca C. Mueller and Crescent M. Scudder and Marianne E. Porter and R. Talbot Trotter and Catherine A. Gehring and Thomas G. Whitham},
 title		= {Differential Tree Mortality in Response to Severe Drought: Evidence for Long‐term Vegetation Shifts},
 journal	= JEcol,
 volume		= 93,
