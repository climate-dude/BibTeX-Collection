@Article{Zarakas_GRL_20241116,
 author		= {Claire M. Zarakas and Daniel Kennedy and Katherine Dagon and David M. Lawrence and Amy Liu and Gordon Bonan and Charles Koven and Danica Lombardozzi and Abigail L. S. Swann},
 title		= {Land Processes Can Substantially Impact the Mean Climate State},
 journal	= GRL,
 volume		= 51,
 number		= 21,
 pages		= {e2024GL108372},
 doi		= {10.1029/2024GL108372},
 day		= 16,
 month		= nov,
 year		= 2024,
 abstract	= {Terrestrial processes influence the atmosphere by controlling land-to-atmosphere fluxes of energy, water, and carbon. Prior research has demonstrated that parameter uncertainty drives uncertainty in land surface fluxes. However, the influence of land process uncertainty on the climate system remains underexplored. Here, we quantify how assumptions about land processes impact climate using a perturbed parameter ensemble for 18 land parameters in the Community Earth System Model version 2 under preindustrial conditions. We find that an observationally-informed range of land parameters generate biogeophysical feedbacks that significantly influence the mean climate state, largely by modifying evapotranspiration. Global mean land surface temperature ranges by 2.2\degree C across our ensemble ($\sigma = 0.5$\degree C) and precipitation changes were significant and spatially variable. Our analysis demonstrates that the impacts of land parameter uncertainty on surface fluxes propagate to the entire Earth system, and provides insights into where and how land process uncertainty influences climate.}
}

