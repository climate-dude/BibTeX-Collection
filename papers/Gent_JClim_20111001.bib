 author		= {Peter R. Gent and Gokhan Danabasoglu and Leo J. Donner and Marika M. Holland and Elizabeth C. Hunke and Steve R. Jayne and David M. Lawrence and Richard B. Neale and Philip J. Rasch and Mariana Vertenstein and Patrick H. Worley and Zong-Liang Yang and Minghua Zhang},
 title		= {The {C}ommunity {C}limate {S}ystem {M}odel Version 4},
 journal	= JClim,
