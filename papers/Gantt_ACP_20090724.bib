 author		= {B. Gantt and N. Meskhidze and D. Kamykowski},
 title		= {A New Physically-based Quantification of Marine Isoprene and Primary Organic Aerosol Emissions},
 journal	= ACP,
 volume		= 9,
 number		= 15,
 pages		= {4915--4927},
 url		= {http://www.atmos-chem-phys.net/9/4915/2009/},
 issn		= {1680-7316},
 day		= 24,
