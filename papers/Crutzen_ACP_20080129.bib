@Article{Crutzen_ACP_20080129,
 author		= {P. J. Crutzen and A. R. Mosier and K. A. Smith and W. Winiwarter},
 title		= {{N}$_2${O} Release from Agro-biofuel Production Negates Global Warming Reduction by Replacing Fossil Fuels},
 journal	= ACP,
 volume		= 8,
 number		= 2,
 pages		= {389--395},
