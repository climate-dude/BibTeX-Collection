 author		= {Weiwei Fu and J. Keith Moore and Fran{\c}ois Primeau and Nathan Collier and Oluwaseun O. Ogunro and Forrest M. Hoffman and James T. Randerson},
 title		= {Evaluation of Ocean Biogeochemistry and Carbon Cycling in {CMIP} {E}arth System Models With the {I}nternational {O}cean {M}odel {B}enchmarking ({IOMB}) Software System},
 journal	= JGRO,
 volume		= 127,
